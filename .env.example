# Connection to the agent's Postgres (read-only access is enough).
# All five required.
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=
# Use 'require' for managed Postgres (Cloud SQL, RDS) with public IP.
# Use 'disable' when going through Cloud SQL Auth Proxy (already encrypted).
DB_SSLMODE=require

# Connection to the agent's Postgres (read-only access is enough).
# All five required.
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=
# Use 'require' for managed Postgres (Cloud SQL, RDS) with public IP.
# Use 'disable' when going through Cloud SQL Auth Proxy (already encrypted).
DB_SSLMODE=require

# Agent API base URL — the status pill probes GET <url>/health directly.
# On the VM (monitor next to the API): http://127.0.0.1:8000
AGENT_API_URL=http://127.0.0.1:8000

[Unit]
Description=cg-sl-agent monitoring dashboard
After=network.target
# If the monitor lives on the same VM as the agent, this lets systemd
# defer startup until the agent's Postgres-side dependencies are warm.
# Comment out if you'd rather monitor stay up regardless of agent state.
After=cg-sl-agent.service

[Service]
# Adjust paths to match where you cloned the repo.
WorkingDirectory=/opt/sl-agent-monitor
EnvironmentFile=/opt/sl-agent-monitor/.env
ExecStart=/opt/sl-agent-monitor/.venv/bin/python serve.py \
    --host 127.0.0.1 \
    --port 8766 \
    --log-file /var/log/cg-sl-agent/agent.log
Restart=on-failure
RestartSec=10
# Run as a non-privileged user where possible; root is fine for now
# since we read /var/log/cg-sl-agent/agent.log which is root-owned.
User=root
StandardOutput=append:/var/log/sl-agent-monitor/monitor.log
StandardError=append:/var/log/sl-agent-monitor/monitor.log

[Install]
WantedBy=multi-user.target
